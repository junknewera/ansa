# Mutate an isolated COPY of production source; the worktree is never edited.
cmake_minimum_required(VERSION 3.25)
set(root "${BINARY}/mutations/${MODE}")
file(MAKE_DIRECTORY "${root}/source")
file(COPY "${SOURCE}/CMakeLists.txt" "${SOURCE}/include" "${SOURCE}/src" "${SOURCE}/tests"
  DESTINATION "${root}/source")
set(file "${root}/source/src/responses.cpp")
file(READ "${file}" original)
set(target "for (const auto& item : response.items()) input.push_back(item);")
if(MODE STREQUAL "drop")
  set(replacement "/* mutation: omit the native output items */")
  set(expected "replay oracle: native item count")
elseif(MODE STREQUAL "reorder")
  set(replacement "for (auto it = response.items().rbegin(); it != response.items().rend(); ++it) input.push_back(*it);")
  set(expected "replay oracle: native item order and values")
else()
  message(FATAL_ERROR "Unknown mutation mode")
endif()
string(REPLACE "${target}" "${replacement}" mutated "${original}")
if(mutated STREQUAL original)
  message(FATAL_ERROR "Production replay mutation site not found; update this test")
endif()
file(WRITE "${file}" "${mutated}")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}/source" -B "${root}/build" -G "${GENERATOR}"
  -DCMAKE_BUILD_TYPE=Debug -DBUILD_TESTING=ON -DOMH_MUTATION_CHILD=ON
  RESULT_VARIABLE configured OUTPUT_VARIABLE log ERROR_VARIABLE error)
if(NOT configured EQUAL 0)
  message(FATAL_ERROR "Mutation configure failed (not a killed mutant): ${log}\n${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${root}/build" --target omh_tests -j 2
  RESULT_VARIABLE compiled OUTPUT_VARIABLE log ERROR_VARIABLE error)
if(NOT compiled EQUAL 0)
  message(FATAL_ERROR "Mutation compile failed (not a killed mutant): ${log}\n${error}")
endif()
execute_process(COMMAND "${root}/build/omh_tests" replay
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 1 OR NOT error MATCHES "${expected}")
  message(FATAL_ERROR "Replay oracle did not kill ${MODE} mutant: ${status} ${output} ${error}")
endif()
message(STATUS "Killed ${MODE} production replay mutant: ${error}")
