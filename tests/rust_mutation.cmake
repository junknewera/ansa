# Mutate a disposable Rust workspace copy; never patch the active source tree.
cmake_minimum_required(VERSION 3.25)
set(root "${BINARY}/rust-mutations/${MODE}")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")
file(COPY "${SOURCE}/rust/Cargo.toml" "${SOURCE}/rust/Cargo.lock" "${SOURCE}/rust/crates" DESTINATION "${root}")
file(COPY "${SOURCE}/tests/fixtures" DESTINATION "${root}/tests")
set(file "${root}/crates/ansa/src/provider/replay.rs")
file(READ "${file}" original)
set(target "input.extend(response.items.iter().map(|i| i.value().clone()));")
if(MODE STREQUAL "drop")
  set(replacement "/* mutation: omit native items */")
  set(expected "replay oracle: native item count")
elseif(MODE STREQUAL "reorder")
  set(replacement "input.extend(response.items.iter().rev().map(|i| i.value().clone()));")
  set(expected "replay oracle: native item order and values")
else()
  message(FATAL_ERROR "Unknown Rust replay mutation mode")
endif()
string(REPLACE "${target}" "${replacement}" mutated "${original}")
if(mutated STREQUAL original)
  message(FATAL_ERROR "Production Rust replay mutation site not found; update this test")
endif()
file(WRITE "${file}" "${mutated}")
set(target_cache "${BINARY}/rust-mutations/drop/target")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "ANSA_PROTOCOL_FIXTURES=${root}/tests/fixtures"
  "CARGO_TARGET_DIR=${target_cache}"
  nix develop --no-update-lock-file -c cargo test
  --manifest-path "${root}/Cargo.toml" -p ansa --locked --test protocol_parity
  replay_serializes_prefix_native_values_and_matching_results -- --exact
  WORKING_DIRECTORY "${root}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
set(log "${output}\n${error}")
if(log MATCHES "could not compile" OR NOT log MATCHES "Finished `test` profile")
  message(FATAL_ERROR "Rust mutation did not reach a compiled assertion: ${status}\n${log}")
endif()
if(status EQUAL 0 OR NOT log MATCHES "${expected}")
  message(FATAL_ERROR "Rust production replay mutant survived ${MODE}: ${status}\n${log}")
endif()
message(STATUS "Killed Rust production replay ${MODE} mutant at ${expected}")
